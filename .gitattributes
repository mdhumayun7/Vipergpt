# Normalize line endings
* text=auto eol=lf
*.sh   text eol=lf
*.py   text eol=lf
*.yaml text eol=lf
*.yml  text eol=lf

# git-lfs for any tracked binary asset that must be versioned (>~1MB)
# Small result figures should be committed as normal SVG/PDF where possible.
*.gif   filter=lfs diff=lfs merge=lfs -text
*.png   filter=lfs diff=lfs merge=lfs -text
*.jpg   filter=lfs diff=lfs merge=lfs -text
*.jpeg  filter=lfs diff=lfs merge=lfs -text
